# Copy to ".env" at the repo root and set your values — ONE env file for the whole stack.
# The backend loads it from the repo root (or backend/.env if that exists — first match wins),
# Vite reads it via envDir (only VITE_*-prefixed vars reach client code),
# and repo tooling (scripts/*.ps1) reads the tooling tokens.
# Real environment variables override these when present. NEVER commit the real .env.

# ============ Backend — database ============
DB_URL=jdbc:postgresql://localhost:5433/gastos
DB_USERNAME=postgres
DB_PASSWORD=dev

# ============ Backend — AI provider ============
# GASTOS_AI_PROVIDER: openai (default) or claude
GASTOS_AI_PROVIDER=openai
# REQUIRED when the provider is openai — the property has no default; startup fails if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# true = your OPENAI_API_KEY serves all users (managed AI, per-plan quotas);
# false (default) = BYOK, each user adds their own key in Settings.
AI_ALLOW_SHARED_KEY=false

# ============ Backend — app behavior ============
# true (default) = seed sample expenses when the table is empty; set false in production.
# When true, also seeds per-tier test accounts: free@/premium@/trial@gastosai.dev (free123/premium123/trial123).
GASTOS_SEED_SAMPLE_DATA=true

# Monetization master switch. false (default) = every feature is unlocked for every user
# (alpha/beta full access); the entitlement system stays wired but inert. Flip to true to
# enforce per-plan access (chat tones, category caps, premium-only features). ADMIN bypasses.
MONETIZATION_ENFORCE=false

# Per-plan category caps (only applied when monetization is enforced). 0 = unlimited.
GASTOS_LIMITS_CATEGORIES_FREE=5
GASTOS_LIMITS_CATEGORIES_PREMIUM=0
GASTOS_LIMITS_CATEGORIES_TRIAL=0

# PayMongo (payment integration — leave blank in dev to disable real charges)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Admin account — set both to auto-create a persistent admin account on startup
# Leave blank (or omit) in production unless you need one
GASTOS_ADMIN_EMAIL=
GASTOS_ADMIN_PASSWORD=

# ============ Frontend (Vite — VITE_* only reach the browser bundle) ============
VITE_API_URL=http://localhost:8080
# VITE_BILLING_ENABLED=false   # uncomment to hide all payment/upgrade UI (free-launch mode); unset = visible

# ============ Repo tooling (scripts/*.ps1 — not read by the app) ============
# Personal access token for the gh CLI
GITHUB_TOKEN=
# Telegram bot for status reports (scripts/notify-telegram.ps1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
