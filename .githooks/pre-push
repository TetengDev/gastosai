#!/bin/sh
# Blocks direct pushes and force pushes to master and release/** branches.
# Use a pull request to merge into these branches instead.

protected_branch() {
  case "$1" in
    master|release/*)
      return 0 ;;
    *)
      return 1 ;;
  esac
}

remote="$1"

while read local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"

  if protected_branch "$branch"; then
    # Detect force push: remote SHA exists and is not an ancestor of local SHA
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo ""
        echo "Force push to '$branch' is not allowed."
        echo "This branch is protected. Open a pull request instead."
        echo ""
        exit 1
      fi
    fi

    # Detect direct push (not coming from a PR merge commit)
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    if [ "$current_branch" = "$branch" ]; then
      echo ""
      echo "Direct push to '$branch' is not allowed."
      echo "This branch is protected. Open a pull request instead."
      echo ""
      exit 1
    fi
  fi
done

exit 0
