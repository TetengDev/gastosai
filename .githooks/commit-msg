#!/bin/sh
# Enforces a version bump in backend/pom.xml and frontend/package.json
# when a commit changes application code and uses a version-triggering type.
#
# Version-triggering types: feat, fix, perf (including breaking variants)
# Version bump is NOT required for: docs, chore, refactor, test, ci, style
# Version bump is NOT required even for feat/fix if only non-app files change
# (e.g. skills, docs, CI config, git hooks).
#
# App code = backend/src/**, frontend/src/**, backend/pom.xml,
#            frontend/package.json, frontend/index.html

msg=$(cat "$1")
staged=$(git diff --cached --name-only)

# --- Check commit type ---
needs_version_check=0
if echo "$msg" | grep -qE "^(feat|fix|perf)(\([^)]+\))?!?:"; then
  needs_version_check=1
fi
if echo "$msg" | grep -qE "^BREAKING CHANGE:"; then
  needs_version_check=1
fi

if [ "$needs_version_check" -eq 0 ]; then
  exit 0
fi

# --- Check if any app code is staged ---
app_code_staged=0
while IFS= read -r file; do
  case "$file" in
    backend/src/*|frontend/src/*|backend/pom.xml|frontend/package.json|frontend/index.html)
      app_code_staged=1
      break
      ;;
  esac
done <<EOF
$staged
EOF

if [ "$app_code_staged" -eq 0 ]; then
  # Only non-app files changed (docs, skills, CI, hooks, etc.) — no bump needed
  exit 0
fi

# --- App code is staged: require version bump in both manifests ---
pom_changed=0
pkg_changed=0
echo "$staged" | grep -q "backend/pom.xml"      && pom_changed=1
echo "$staged" | grep -q "frontend/package.json" && pkg_changed=1

if [ "$pom_changed" -eq 0 ] || [ "$pkg_changed" -eq 0 ]; then
  bump_hint="PATCH (e.g. 0.3.1 → 0.3.2)"
  if echo "$msg" | grep -qE "^(feat)(\([^)]+\))?:"; then
    bump_hint="MINOR (e.g. 0.3.1 → 0.4.0)"
  fi
  if echo "$msg" | grep -qE "^(feat|fix|perf)(\([^)]+\))?!:|^BREAKING CHANGE:"; then
    bump_hint="MAJOR if >= 1.0.0, MINOR if pre-1.0 (e.g. 0.3.1 → 0.4.0)"
  fi

  echo ""
  echo "SemVer enforcement: app code changed — version bump required."
  echo "  Bump type : $bump_hint"
  echo "  Missing   :"
  [ "$pom_changed" -eq 0 ] && echo "    - backend/pom.xml  (update <version>)"
  [ "$pkg_changed" -eq 0 ] && echo "    - frontend/package.json  (update \"version\")"
  echo ""
  echo "Both files must be bumped together and to the same version."
  echo "Also update CHANGELOG.md with what changed under [Unreleased]."
  echo "Use --no-verify only if you are intentionally deferring the release."
  echo ""
  exit 1
fi
